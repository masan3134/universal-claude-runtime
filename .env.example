# Universal Claude Runtime — production environment template
# Universal Claude Runtime — production ortam şablonu
#
# Copy only the variables you need to:
# Yalnızca gereken değişkenleri şuraya kopyalayın:
# ~/.config/universal-claude-runtime/secrets.env
#
# Never commit real values. Keep the secret file at mode 600.
# Gerçek değerleri Git'e yazmayın. Secret dosyasını 600 modunda tutun.

# Meta Muse — primary and accepted compatibility alias
META_MODEL_API_KEY=
META_API_KEY=

# DeepSeek — primary and accepted compatibility alias
DEEPSEEK_API_KEY=
DEEPSEEK_NEW_API=

# Runtime selection / Runtime seçimi
UCR_DEFAULT_PROFILE=deepseek-flash

# Optional persistent tmux sessions / Opsiyonel kalıcı tmux oturumları
UCR_TMUX_ENABLED=false

# Optional verified binary override / Opsiyonel doğrulanmış binary override
# UCR_CLAUDE_BINARY=/opt/universal-claude-runtime/claude-code/active/claude

# Reserved for future structured logging; current v1 scripts do not implement
# a full logging subsystem.
# Gelecekteki structured logging için ayrılmıştır; v1 tam log sistemi sağlamaz.
UCR_LOG_LEVEL=info
